name: kidview
description: "A safe and educational video platform for children."
publish_to: 'none'
version: 1.0.0+1

environment:
  sdk: ^3.7.0

dependencies:
  flutter:
    sdk: flutter
  cupertino_icons: ^1.0.8
  
  # State Management
  provider: ^6.1.1
  
  # Navigation
  go_router: ^13.1.0
  
  # UI Components
  cached_network_image: ^3.3.0
  
  # Media
  video_player: 2.7.0
  
  # Authentication & Security
  firebase_auth: ^4.15.0
  firebase_core: ^2.24.0
  
  # Database
  cloud_firestore: ^4.13.3
  shared_preferences: ^2.2.2
  
  # Analytics
  firebase_analytics: ^10.7.4
  
  # Localization
  flutter_localizations:
    sdk: flutter
  intl: ^0.19.0

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0

flutter:
  uses-material-design: true
  
  assets:
    - assets/images/
  # Fonts
  fonts:
    - family: Nunito
      fonts:
        - asset: assets/fonts/Nunito-Regular.ttf
        - asset: assets/fonts/Nunito-Bold.ttf
          weight: 700
        - asset: assets/fonts/Nunito-SemiBold.ttf
          weight: 600
        - asset: assets/fonts/Nunito-Italic.ttf
          style: italic
        - asset: assets/fonts/Nunito-BoldItalic.ttf
          weight: 700
          style: italic